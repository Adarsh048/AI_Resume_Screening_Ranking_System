# GitHub API token (optional — raises rate limit from 60 to 5000 req/hour)
# Generate at: https://github.com/settings/tokens (no scopes required for public data)
GITHUB_TOKEN=

# OpenAI API key (optional — enables LLM project-quality evaluation)
OPENAI_API_KEY=
# Model to use (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Google Gemini API key (optional — alternative LLM provider)
GEMINI_API_KEY=
# Model to use (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash
